#include "mcinfo.h"

#include "json_defs_p.h"

#include <map>
#include <sstream>
#include <string>
#include <utility>

static const char* mcinfo_spec_str_ =
R"-(
@MCINFO_SPEC@
)-";

std::string mcinfo::info_spec()
{
    std::istringstream is(mcinfo_spec_str_);
    ojson info_specs = ojson::parse(is, nullptr, true, true);

    {
        ojson tally_specs(ojson::array({}));

        // map: group name -> dataset name -> (tally index, is_sem)
        // both maps are ordered, which reproduces the ordering seen in the file
        std::map<std::string, std::map<std::string, std::pair<int, bool>>> tmap;
        int k = 1;
        while (k < tally::std_tallies) {
            std::string nm(tally::arrayName(k));
            tmap[tally::arrayGroup(k)][nm] = { k, false };
            tmap[tally::arrayGroup(k)][nm + "_sem"] = { k, true };
            k++;
        }

        for (const auto &tgroup : tmap) {
            ojson group_j(ojson::object({}));

            group_j["id"] = tgroup.first;
            group_j["type"] = "Group";
            group_j["description"] = "";

            ojson objects(ojson::array({}));
            for (const auto &tname : tgroup.second) {
                ojson tally_j(ojson::object({}));
                int k = tname.second.first;
                bool is_sem = tname.second.second;
                std::string desc(tally::arrayDescription(k));
                if (is_sem)
                    desc += " (SEM)";
                tally_j["id"] = tname.first;
                tally_j["type"] = "Dataset";
                tally_j["description"] = desc;
                tally_j["datatype"] = "Numeric";
                tally_j["size"] = "\\f$[N_{at},N_x,N_y,N_z]\\f$";

                objects.push_back(tally_j);
            }
            group_j["objects"] = objects;

            tally_specs.push_back(group_j);
        }

        // the table of totals
        {
            ojson group_j(ojson::object({}));
            group_j["id"] = "totals";
            group_j["type"] = "Group";
            group_j["description"] = "Tally totals summed over all cells";

            ojson objects(ojson::array({}));

            ojson d(ojson::object({}));
            d["id"] = "data";
            d["type"] = "Dataset";
            d["description"] = "Tally totals per atom";
            d["datatype"] = "Numeric";
            d["size"] = "\\f$[N_{tally},N_{at}]\\f$";
            objects.push_back(d);

            d["id"] = "data_sem";
            d["description"] = "Tally totals per atom (SEM)";
            objects.push_back(d);

            d["id"] = "column_names";
            d["description"] = "Names of the tally totals";
            d["datatype"] = "Text";
            d["size"] = "\\f$[N_{tally}]\\f$";
            objects.push_back(d);

            group_j["objects"] = objects;
            tally_specs.push_back(group_j);
        }

        ojson::json_pointer ptr("/objects/3/objects");
        info_specs[ptr] = tally_specs;
    }

    return info_specs.dump(4);

}