#include "json_defs_p.h"

// clang-format off

static const char* option_spec_str_ =
R"-(
@OPTIONS_SPEC@
)-";

// clang-format on

std::string mcconfig::options_spec()
{
    return std::string(option_spec_str_);
}

const ojson &json_options_spec()
{
    static ojson options_spec_;

    if (options_spec_.is_null()) {
        options_spec_ = ojson::parse(option_spec_str_, nullptr, true, true);
    }

    return options_spec_;
}
